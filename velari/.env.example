# ─────────────────────────────────────────────────────────────────
# Velari – Environment variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────

# Anthropic API key for the AI chatbot widget.
# Get yours at https://console.anthropic.com
#
# ⚠️  WARNING: This key is exposed in the client-side bundle.
#    For production, proxy requests through /api/chat.php on Hostinger
#    (see README.md § "Seguridad del chatbot") to keep the key private.
VITE_ANTHROPIC_API_KEY=sk-ant-...
